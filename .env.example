# ORUM · Plantilla de variables de entorno
#
# Copia este archivo a `.env.local` y rellena los valores reales:
#   cp .env.example .env.local
#
# `.env.local` NUNCA se sube al repositorio (está en .gitignore).
# Los valores salen del panel de Supabase: Project Settings -> API.

# URL del proyecto de Supabase. Ej.: https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave publicable (formato nuevo: empieza por `sb_publishable_`).
# Se expone al navegador a propósito: solo permite lo que autoricen las
# políticas de la base de datos.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de servicio (formato nuevo: empieza por `sb_secret_`).
#
# ATENCIÓN: salta cualquier política de seguridad de la base de datos.
# Solo se usa en el servidor, aislada en `src/lib/supabase/admin.ts`.
# No lleva el prefijo NEXT_PUBLIC_ y no debe llevarlo nunca: eso la
# publicaría en el bundle del navegador.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Correo de bienvenida (MailerSend) — OPCIONAL
#
# Al registrar un miembro o un usuario se le envían sus credenciales por
# correo. El envío es "best-effort": si estas variables faltan o el servicio
# falla, el registro se completa igual y el error solo queda en el log del
# servidor. Por eso conviene revisarlas: una ausencia NO da error visible.
# ---------------------------------------------------------------------------

# Clave de API de MailerSend.
MAILERSEND_API_KEY=

# Remitente verificado en MailerSend. Ej.: no-responder@tudominio.com
MAILERSEND_FROM_EMAIL=

# Base para construir el enlace de inicio de sesión del correo.
# En local puede omitirse: por defecto usa http://localhost:3000
NEXT_PUBLIC_SITE_URL=
